{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "client x",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder:client}/lib/client.dart",
            "args": [
                "-d",
                "chrome"
            ],
            "flutterMode": "debug",
            "deviceId": "chrome",
            "dart.flutterHotReloadOnSave": "all"
        },
        {
            "name": "server x",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder:server}/lib/server.dart",
            "cwd": "${workspaceFolder}",
            "args": [],
            "dartAdditionaArgs": ["--enable-assets"],
            "dart.hotReloadOnSave": "all"
        }
    ],
    "compounds": [
      {
        "name": "Server and Client",
        "configurations": ["server x","client x"]
      }
    ]
}