FROM dart:stable

# Install dependencies
RUN apt-get update && \
    apt-get install -y curl git unzip wget xz-utils

# Set Flutter version and path
ENV FLUTTER_VERSION=3.22.2 \
    FLUTTER_ROOT=/opt/flutter
ENV PATH="$FLUTTER_ROOT/bin:$FLUTTER_ROOT/bin/cache/dart-sdk/bin:$PATH"

# Create directory and download Flutter SDK
RUN mkdir -p $FLUTTER_ROOT
WORKDIR $FLUTTER_ROOT

# Download and extract Flutter
RUN git clone --depth 1 -b stable https://github.com/flutter/flutter.git /opt/flutter
